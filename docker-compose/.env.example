# Environment Variables for SearXNG Cluster
# Copy this file to .env and customize

# Secret key for SearXNG (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-this-secret-key-in-production

# Optional: External Redis/Valkey URL (if not using docker-compose valkey)
# SEARXNG_VALKEY_URL=valkey://localhost:6379/0

# Optional: Custom instance names
# SEARXNG_INSTANCE_1_NAME=SearXNG-Primary
# SEARXNG_INSTANCE_2_NAME=SearXNG-Secondary
# SEARXNG_INSTANCE_3_NAME=SearXNG-Tertiary

# Optional: Performance tuning
# GRANIAN_MAX_THREADS=4
# GRANIAN_BACKLOG=2048

# Optional: Resource limits
# SEARXNG_MEMORY_LIMIT=512m
# SEARXNG_CPU_LIMIT=1.0
